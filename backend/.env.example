# Ordered failover keys. Key 1 is tried first; on 429/401/402/403/5xx/timeouts the
# same request is retried with key 2 (then 3...). A single legacy LLM_API_KEY still works.
LLM_API_KEY_1=
LLM_API_KEY_2=
# LLM_API_KEY_3=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# This model is prompted for JSON and validated server-side. Enable only for a
# provider/model that explicitly supports the JSON Schema response format.
LLM_STRUCTURED_OUTPUTS=false
LLM_TIMEOUT_SECONDS=30
COPILOT_MAX_MESSAGE_CHARS=2000
COPILOT_MAX_TOOL_CALLS=4
COPILOT_RATE_LIMIT_REQUESTS=20
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
TELLUS_ALLOWED_ORIGINS=http://localhost:5173
