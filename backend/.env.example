# Ordered failover keys. Key 1 is tried first; on 429/401/402/403/5xx/timeouts the
# same request is retried with key 2 (then 3...). A single legacy LLM_API_KEY still works.
LLM_API_KEY_1=
LLM_API_KEY_2=
# LLM_API_KEY_3=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Replies are schema-constrained and then validated server-side. Keep true only
# for models OpenRouter lists with "structured_outputs" support.
LLM_STRUCTURED_OUTPUTS=true
# Reasoning models think before answering; too small a budget returns empty replies.
LLM_MAX_TOKENS=4000
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=45
COPILOT_MAX_MESSAGE_CHARS=2000
COPILOT_MAX_TOOL_CALLS=4
COPILOT_RATE_LIMIT_REQUESTS=20
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
TELLUS_ALLOWED_ORIGINS=http://localhost:5173
