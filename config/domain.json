{
  "domain": {
    "name": "Whole Earth",
    "lon_min": -180.0,
    "lon_max": 180.0,
    "lat_min": -90.0,
    "lat_max": 90.0,
    "resolution": 0.5,
    "crs": "WGS84"
  },
  "power": {
    "base_url": "https://power.larc.nasa.gov/api/temporal/monthly/regional",
    "community": "AG",
    "start_year": 1981,
    "end_year": 2025,
    "tile_degrees": 10,
    "max_workers": 5,
    "politeness_delay_s": 0.3,
    "fill_value": -999.0
  },
  "gpcp": {
    "url": "https://downloads.psl.noaa.gov/Datasets/gpcp/precip.mon.mean.nc",
    "version": "GPCP V2.3 Combined Precipitation Dataset (Final)",
    "source": "NOAA PSL / NASA GES DISC"
  },
  "variables": [
    {
      "id": "T2M",
      "short_name": "Temperature",
      "long_name": "Air Temperature at 2 Meters",
      "definition": "The average temperature of the air 2 metres above the ground, the height standard weather stations measure at.",
      "units": "°C",
      "monthly_units": "°C (monthly mean)",
      "aggregation": "mean",
      "trend_units": "°C per decade",
      "higher_means": "warmer",
      "suitable_for": "Warming and cooling questions",
      "caveat": "Reanalysis 2-metre temperature can diverge from surface-station records over the Indo-Gangetic Plain, where station data show stronger warming. Regional results there deserve extra caution.",
      "power_parameter": "T2M"
    },
    {
      "id": "T2M_MAX",
      "short_name": "Daytime max temperature",
      "long_name": "Maximum Temperature at 2 Meters",
      "definition": "The highest air temperature reached each month, 2 metres above the ground. Reflects how hot days become.",
      "units": "°C",
      "monthly_units": "°C (monthly mean of daily maxima)",
      "aggregation": "mean",
      "trend_units": "°C per decade",
      "higher_means": "hotter daytime extremes",
      "suitable_for": "Heat-extreme questions",
      "power_parameter": "T2M_MAX"
    },
    {
      "id": "T2M_MIN",
      "short_name": "Nighttime min temperature",
      "long_name": "Minimum Temperature at 2 Meters",
      "definition": "The lowest air temperature reached each month, 2 metres above the ground. Reflects how cold nights become.",
      "units": "°C",
      "monthly_units": "°C (monthly mean of daily minima)",
      "aggregation": "mean",
      "trend_units": "°C per decade",
      "higher_means": "warmer nights",
      "suitable_for": "Nighttime warming questions",
      "power_parameter": "T2M_MIN"
    },
    {
      "id": "PRECTOTCORR",
      "short_name": "Precipitation",
      "long_name": "Corrected Total Precipitation",
      "definition": "All rain and snow that reaches the ground, bias-corrected against ground stations. Monthly values are averages in millimetres per day; the tool converts them to totals.",
      "units": "mm",
      "monthly_units": "mm/day (monthly mean rate)",
      "aggregation": "sum",
      "trend_units": "mm per decade",
      "higher_means": "wetter",
      "suitable_for": "Rainfall increase/decrease questions",
      "caution": "Rainfall alone cannot establish drought or aridity; combine with soil wetness and evaporation.",
      "known_divergence": "MERRA-2 precipitation over South Asia shows stronger wetting trends than observed datasets (GPCP). Always check the GPCP observed cross-check panel for this variable.",
      "power_parameter": "PRECTOTCORR"
    },
    {
      "id": "RH2M",
      "short_name": "Relative humidity",
      "long_name": "Relative Humidity at 2 Meters",
      "definition": "How close the air is to saturation with water vapour (100% = fully saturated).",
      "units": "%",
      "monthly_units": "% (monthly mean)",
      "aggregation": "mean",
      "trend_units": "percentage points per decade",
      "higher_means": "more humid",
      "suitable_for": "Moisture and heat-stress context",
      "power_parameter": "RH2M"
    },
    {
      "id": "WS10M",
      "short_name": "Wind speed",
      "long_name": "Wind Speed at 10 Meters",
      "definition": "The average speed of wind 10 metres above the ground.",
      "units": "m/s",
      "monthly_units": "m/s (monthly mean)",
      "aggregation": "mean",
      "trend_units": "m/s per decade",
      "higher_means": "windier",
      "suitable_for": "Wind-energy and storm-context questions",
      "power_parameter": "WS10M"
    },
    {
      "id": "GWETTOP",
      "short_name": "Surface soil wetness",
      "long_name": "Surface Soil Wetness (top 5 cm)",
      "definition": "How wet the topmost soil layer is, from 0 (bone dry) to 1 (saturated), estimated by a land surface model.",
      "units": "0–1 fraction",
      "monthly_units": "0–1 (monthly mean)",
      "aggregation": "mean",
      "trend_units": "fraction per decade",
      "higher_means": "wetter soils",
      "suitable_for": "Drying/wetting context (with caution)",
      "caution": "Model estimate, not a measurement; drought assessment needs more than one variable.",
      "power_parameter": "GWETTOP"
    },
    {
      "id": "EVLAND",
      "short_name": "Evaporation",
      "long_name": "Evaporation over Land",
      "definition": "Water evaporated from land and plants into the air. Monthly values are averages in millimetres per day; the tool converts them to totals.",
      "units": "mm",
      "monthly_units": "mm/day (monthly mean rate)",
      "aggregation": "sum",
      "trend_units": "mm per decade",
      "higher_means": "more evaporative demand",
      "suitable_for": "Water-loss context",
      "power_parameter": "EVLAND"
    }
  ],
  "seasons": {
    "annual": {
      "months": [
        1,
